    {
      "parameters": {
        "jsCode": "// Runs directly behind the webhook. A body the router cannot route safely is\n// replaced by {status: 'malformed'}, which the Alert Status switch sends to the\n// malformed-alert notifications. A valid body passes through unchanged. This\n// node never throws, so an authenticated call cannot end in silence.\nconst isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);\nlet item;\ntry {\n  item = $input.first().json;\n} catch (e) {\n  item = {};\n}\nlet ok = false;\ntry {\n  const b = isObj(item) ? item.body : undefined;\n  ok = isObj(b)\n    && (b.status === 'firing' || b.status === 'resolved')\n    && Array.isArray(b.alerts) && b.alerts.length >= 1 && isObj(b.alerts[0])\n    && (b.alerts[0].labels === undefined || isObj(b.alerts[0].labels))\n    && (b.alerts[0].annotations === undefined || isObj(b.alerts[0].annotations));\n} catch (e) {\n  ok = false;\n}\nif (ok) { return [{ json: item }]; }\nreturn [{ json: { body: { status: 'malformed', alerts: [] } } }];\n"
      },
