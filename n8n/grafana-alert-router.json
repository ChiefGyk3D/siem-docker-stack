    {
      "parameters": {
        "jsCode": "const PUSHOVER_ENABLED = false;\nconst PUSHOVER_RETRY = 300;\nconst PUSHOVER_EXPIRE = 10800;\nconst ALLOWED_DASHBOARD_ORIGIN = '';\nconst ALLOWED_ALERTNAMES = [\n  'UniFi update pending over 24h',\n  'UniFi update pending over 7 days',\n  'pfSense update pending over 24h',\n  'pfSense update pending over 7 days',\n  'pfSense SECURITY update pending',\n  'pfSense update check failing or stale'\n];\n// PUSHOVER_ENABLED: set to true to send to Pushover. Retry is the seconds\n// between repeats of an emergency message (minimum 30). Expire is when repeats\n// stop (maximum 10800). ALLOWED_DASHBOARD_ORIGIN: only an https link on exactly\n// this origin is forwarded; the empty default drops every link. Example:\n// 'https://grafana.example.com'. ALLOWED_ALERTNAMES: only these alert names can\n// page at emergency priority or cancel repeats; keep it equal to the titles in\n// docker/grafana/provisioning/alerting/update-alert-rules-*.yml.\n// No Pushover credential is handled here: the HTTP Request nodes add them from\n// the n8n credential pushover-api.\n\nconst isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);\nconst str = (v, max) => {\n  if (typeof v === 'string') { return v.slice(0, max); }\n  if (typeof v === 'number' && isFinite(v)) { return String(v).slice(0, max); }\n  return '';\n};\n\nfunction sha256hex(s) {\n  const rotr = (x, n) => (x >>> n) | (x << (32 - n));\n  const primes = [];\n  for (let n = 2; primes.length < 64; n++) {\n    let ok = true;\n    for (let d = 2; d * d <= n; d++) { if (n % d === 0) { ok = false; break; } }\n    if (ok) { primes.push(n); }\n  }\n  const K = primes.map((p) => Math.floor((Math.cbrt(p) % 1) * 4294967296));\n  let H = primes.slice(0, 8).map((p) => Math.floor((Math.sqrt(p) % 1) * 4294967296));\n  const m = [];\n  for (let i = 0; i < s.length; i++) { m.push(s.charCodeAt(i) & 255); }\n  const bits = m.length * 8;\n  m.push(0x80);\n  while (m.length % 64 !== 56) { m.push(0); }\n  m.push(0, 0, 0, 0, (bits >>> 24) & 255, (bits >>> 16) & 255, (bits >>> 8) & 255, bits & 255);\n  for (let o = 0; o < m.length; o += 64) {\n    const w = new Array(64);\n    for (let t = 0; t < 16; t++) {\n      w[t] = (m[o + 4 * t] << 24) | (m[o + 4 * t + 1] << 16) | (m[o + 4 * t + 2] << 8) | m[o + 4 * t + 3];\n    }\n    for (let t = 16; t < 64; t++) {\n      const s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >>> 3);\n      const s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >>> 10);\n      w[t] = (w[t - 16] + s0 + w[t - 7] + s1) | 0;\n    }\n    let [a, b, c, d, e, f, g, h] = H;\n    for (let t = 0; t < 64; t++) {\n      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);\n      const ch = (e & f) ^ (~e & g);\n      const t1 = (h + S1 + ch + K[t] + w[t]) | 0;\n      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);\n      const maj = (a & b) ^ (a & c) ^ (b & c);\n      const t2 = (S0 + maj) | 0;\n      h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;\n    }\n    const v = [a, b, c, d, e, f, g, h];\n    H = H.map((x, i) => (x + v[i]) | 0);\n  }\n  return H.map((x) => ('00000000' + (x >>> 0).toString(16)).slice(-8)).join('');\n}\n\nfunction safeDashboardUrl(u) {\n  if (!ALLOWED_DASHBOARD_ORIGIN || typeof u !== 'string' || u.length > 512) { return ''; }\n  if (/[\\\\\\u0000-\\u001f\\u007f]/.test(u)) { return ''; }\n  let allowed;\n  let p;\n  try { allowed = new URL(ALLOWED_DASHBOARD_ORIGIN); p = new URL(u); } catch (e) { return ''; }\n  if (allowed.protocol !== 'https:') { return ''; }\n  if (p.protocol !== 'https:' || p.username || p.password) { return ''; }\n  if (p.origin !== allowed.origin) { return ''; }\n  return p.href.length > 512 ? '' : p.href;\n}\n\nfunction build() {\n  const raw = $input.first().json.body;\n  if (!isObj(raw)) { throw new Error('body'); }\n  if (raw.status !== 'firing' && raw.status !== 'resolved') { throw new Error('status'); }\n  if (!Array.isArray(raw.alerts) || raw.alerts.length < 1) { throw new Error('alerts'); }\n  const a = raw.alerts[0];\n  if (!isObj(a)) { throw new Error('alert'); }\n  const l = a.labels === undefined ? {} : a.labels;\n  const an = a.annotations === undefined ? {} : a.annotations;\n  if (!isObj(l) || !isObj(an)) { throw new Error('maps'); }\n  const resolved = raw.status === 'resolved';\n  const alertname = str(l.alertname, 200);\n  const known = ALLOWED_ALERTNAMES.indexOf(alertname) !== -1;\n  const severity = str(l.severity, 20);\n  const urgent = severity === 'critical' || str(l.update_security, 10) === 'true';\n  let prio = 0;\n  if (!resolved) {\n    if (known && urgent) { prio = 2; } else if (urgent || severity === 'warning') { prio = 1; }\n  }\n  const title = ((resolved ? 'RESOLVED: ' : '') + (alertname || 'Grafana alert')).slice(0, 250);\n  const summary = str(an.summary, 300) || ('Alert condition ' + (resolved ? 'cleared' : 'is true'));\n  const description = str(an.description, 600);\n  const msg = (summary + (description ? '\\n' + description : '')\n    + (raw.alerts.length > 1 ? '\\n(+' + (raw.alerts.length - 1) + ' more alerts)' : '')).slice(0, 1024);\n  const fingerprint = str(a.fingerprint, 64);\n  const tag = (known && /^[0-9a-fA-F]{1,64}$/.test(fingerprint))\n    ? 'upd-' + sha256hex(alertname + '|' + fingerprint).slice(0, 32) : '';\n  const o = { title: title, message: msg, priority: prio };\n  if (prio === 2) {\n    o.retry = Math.max(30, Math.floor(Number(PUSHOVER_RETRY)) || 300);\n    o.expire = Math.min(10800, Math.floor(Number(PUSHOVER_EXPIRE)) || 10800);\n    if (tag) { o.tags = tag; }\n  }\n  const url = safeDashboardUrl(a.dashboardURL);\n  if (url) { o.url = url; }\n  return { enabled: PUSHOVER_ENABLED === true, pushover: o, cancelTag: resolved ? tag : '' };\n}\n\nlet out;\ntry {\n  out = build();\n} catch (e) {\n  out = {\n    enabled: PUSHOVER_ENABLED === true,\n    pushover: {\n      title: 'Alert router: malformed alert',\n      message: 'The router received a malformed alert from the webhook. Check the sender and the n8n execution log.',\n      priority: 1,\n    },\n    cancelTag: '',\n  };\n}\nreturn [{ json: out }];\n"
      },
