# Basic-auth users for the OTLP receiver instance, one per role so each can be
# rotated or revoked on its own: sender (OTLP senders), grafana (reads),
# scrape (the SIEM Prometheus scraping this instance's /metrics).
# The real file, docker/prometheus-otlp/web.yml, is rendered by
# scripts/render-prometheus-web-config.sh and is not committed. The values below
# are placeholders, not hashes: render the real file with the script.
basic_auth_users:
  sender: REPLACE_WITH_BCRYPT_HASH
  grafana: REPLACE_WITH_BCRYPT_HASH
  scrape: REPLACE_WITH_BCRYPT_HASH
