# Twingate Connector update collector (issue #222). Install by hand; see
# docs/live-deploy-runbook.md, section "Twingate collector". Replace /opt/siem with the
# checkout of this repository and <user> with the account that owns the secret-manager
# token file. No secret value belongs in this file: siem-run reads the token from
# <home>/.config/doppler-siem/token.
[Unit]
Description=Collect Twingate Connector update metrics into InfluxDB
Wants=network-online.target
After=network-online.target
OnFailure=twingate-collect-failure.service

[Service]
Type=oneshot
User=<user>
# The first bash starts with an empty environment (env -i) and only what is listed here:
# a fixed PATH, LC_ALL, HOME and SIEM_CONFIG_DIR. Add INFLUX_URL=... or TWINGATE_INFLUX_DB=...
# to this line if the defaults (http://127.0.0.1:8086, telegraf) do not fit. The service
# token is read by siem-run from the token file and reaches nothing else; no secret value
# and no secret name belongs on this line.
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C HOME=/home/<user> SIEM_CONFIG_DIR=/home/<user>/.config/doppler-siem /opt/siem/scripts/live-deploy/twingate-collect
TimeoutStartSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
LimitCORE=0
# The doppler CLI keeps a small cache; give it a private writable place inside the sandbox.
# (--fallback-readonly in siem-run uses the token directory under the read-only home.)
